# ---------------------------------------------------------------------------
# QuickMenu QR — environment template
# Copy to .env for the API (apps/api) and apps/web/.env.local for the web app.
# Never commit real values. .env is ignored by git.
# ---------------------------------------------------------------------------

# API runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
DB_POOL_MAX=20

# Database (Docker Compose defaults shown)
DATABASE_URL=postgres://quickmenu:quickmenu@localhost:5432/quickmenu
TEST_DATABASE_URL=postgres://quickmenu:quickmenu@localhost:5432/quickmenu_test
MIGRATIONS_DIR=

# Secrets — each at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-long-random-string-0123456789
JWT_REFRESH_SECRET=change-me-another-long-random-string-abcdef
TRACKING_SECRET=change-me-third-long-random-string-zyxwvutsrq

# Browser origins (comma-separated allow-list, no trailing slash)
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_MENU_BASE_URL=http://localhost:3000/m

# Cloudinary — leave empty in development/test to use the fake media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Translation: fake | libretranslate | google
TRANSLATION_PROVIDER=fake
TRANSLATION_API_KEY=

# Password-reset mail: console | smtp
MAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Optional integrations
REDIS_URL=
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Web app (browser-side, prefix NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ---------------------------------------------------------------------------
# End-to-end tests (optional)
# PLAYWRIGHT_CHANNEL=msedge   # use an installed browser instead of Chromium
# E2E_BASE_URL=http://localhost:3000
# ---------------------------------------------------------------------------
