{
  "name": "quickmenu-qr",
  "version": "0.1.0",
  "private": true,
  "description": "QuickMenu QR – multi-tenant digital menu and ordering system",
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "cd apps/api && npm run dev",
    "dev:web": "cd apps/web && npm run dev",
    "build": "npm-run-all build:shared build:api build:web",
    "build:shared": "cd packages/shared && npm run build",
    "build:api": "cd apps/api && npm run build",
    "build:web": "cd apps/web && npm run build",
    "lint": "npm-run-all --parallel lint:api lint:web lint:shared",
    "lint:api": "cd apps/api && npm run lint",
    "lint:web": "cd apps/web && npm run lint",
    "lint:shared": "cd packages/shared && npm run lint",
    "typecheck": "npm-run-all --parallel typecheck:api typecheck:web typecheck:shared",
    "typecheck:api": "cd apps/api && npm run typecheck",
    "typecheck:web": "cd apps/web && npm run typecheck",
    "typecheck:shared": "cd packages/shared && npm run typecheck",
    "test": "npm-run-all --parallel test:api test:shared",
    "test:api": "cd apps/api && npm run test",
    "test:shared": "cd packages/shared && npm run test",
    "test:coverage": "cd apps/api && npm run test:coverage",
    "test:e2e": "playwright test",
    "db:migrate": "cd apps/api && npm run db:migrate",
    "db:reset": "cd apps/api && npm run db:reset",
    "db:seed": "cd apps/api && npm run db:seed",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-unicorn": "^53.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "npm-run-all": "^2.3.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.0"
  }
}
